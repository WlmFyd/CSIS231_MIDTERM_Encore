<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    spacing="24"
    styleClass="page, app-root"
    fx:controller="com.example.midterm_cinema.controller.DashboardController"
    stylesheets="@../css/theme.css"
    prefWidth="1180"
    prefHeight="740">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="10">
            <Label text="ENCORE / ADMINISTRATION" styleClass="eyebrow"/>
            <Label text="A clear view of the show." styleClass="section-title"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton" text="Refresh statistics" onAction="#refresh" styleClass="outline-button"/>
    </HBox>
    <HBox spacing="20">
        <VBox spacing="14" styleClass="panel" HBox.hgrow="ALWAYS">
            <Label text="CONFIRMED BOOKINGS" styleClass="eyebrow"/>
            <Label fx:id="bookingsLabel" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="14" styleClass="panel" HBox.hgrow="ALWAYS">
            <Label text="TICKETS SOLD" styleClass="eyebrow"/>
            <Label fx:id="ticketsLabel" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="14" styleClass="panel" HBox.hgrow="ALWAYS">
            <Label text="TOTAL REVENUE" styleClass="eyebrow"/>
            <Label fx:id="revenueLabel" text="—" styleClass="stat-value"/>
        </VBox>
    </HBox>
    <Label text="Performance by movie" styleClass="section-title"/>
    <TableView fx:id="statisticsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="movieColumn" text="Movie" prefWidth="430"/>
            <TableColumn fx:id="bookingsColumn" text="Bookings" prefWidth="160"/>
            <TableColumn fx:id="ticketsColumn" text="Tickets sold" prefWidth="160"/>
            <TableColumn fx:id="revenueColumn" text="Revenue" prefWidth="200"/>
        </columns>
    </TableView>
    <Label fx:id="statusLabel" styleClass="muted" wrapText="true"/>
</VBox>
